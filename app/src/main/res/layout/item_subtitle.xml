<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- 序号 -->
        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/bg_index"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- 字幕内容 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <!-- 时间轴 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <!-- 开始时间 -->
                <TextView
                    android:id="@+id/tvStartTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"
                    tools:text="00:00:01,500" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/item_subtitle_text_01"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp"
                    android:paddingHorizontal="4dp" />
                
                <!-- 结束时间 -->
                <TextView
                    android:id="@+id/tvEndTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"
                    tools:text="00:00:04,000" />
            </LinearLayout>

            <!-- WebVTT cue identifier/settings；无属性时由适配器隐藏 -->
            <TextView
                android:id="@+id/tvFormatMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/on_surface"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="ID: intro · line:90% align:start"
                tools:visibility="visible" />

            <!-- 字幕文本 -->
            <TextView
                android:id="@+id/tvSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="这是一条测试字幕" />

        </LinearLayout>

        <!-- 选中指示器和操作按钮容器 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">
            
            <!-- 选中指示器 -->
            <ImageView
                android:id="@+id/ivSelected"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                android:contentDescription="@string/item_subtitle_contentdescription_01" />
            
            <!-- 右上按钮：跳转到字幕时间 -->
            <ImageButton
                android:id="@+id/btnJumpToTime"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_media_play"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/item_subtitle_contentdescription_02"
                android:visibility="gone"
                android:scaleType="centerInside" />
            
            <!-- 右下按钮：设置字幕时间为当前进度 -->
            <ImageButton
                android:id="@+id/btnSetTime"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/item_subtitle_contentdescription_03"
                android:visibility="gone"
                android:scaleType="centerInside" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
