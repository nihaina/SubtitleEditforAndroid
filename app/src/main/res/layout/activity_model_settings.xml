<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ModelSettingsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="语音转录设置" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 语音转字幕高级配置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_model_settings_text_01"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/activity_model_settings_text_02"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnSpeechAdvancedSettings"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/activity_model_settings_text_03" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Whisper 模型文件 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAsrModelTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/activity_model_settings_text_04"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface" />

                            <TextView
                                android:id="@+id/tvEncoderLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/activity_model_settings_text_05"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface" />

                            <LinearLayout
                                android:id="@+id/layoutModelFile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvEncoderFile"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="middle"
                                    android:singleLine="true"
                                    android:text="@string/activity_auto_timestamp_text_04"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <Button
                                        android:id="@+id/btnSelectEncoder"
                                        style="@style/Widget.Material3.Button.OutlinedButton"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:minWidth="0dp"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:singleLine="true"
                                        android:text="@string/activity_model_settings_text_06" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnDownloadAsrModel"
                                        style="@style/Widget.MaterialComponents.Button"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_marginStart="8dp"
                                        android:backgroundTint="@color/primary"
                                        android:contentDescription="@string/activity_model_settings_contentdescription_01"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp"
                                        android:padding="5dp"
                                        android:visibility="gone"
                                        app:cornerRadius="14dp"
                                        app:icon="@drawable/ic_download"
                                        app:iconGravity="textStart"
                                        app:iconPadding="0dp"
                                        app:iconSize="18dp"
                                        app:iconTint="@color/white" />

                                    <TextView
                                        android:id="@+id/btnResetAsrModel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="28dp"
                                        android:layout_marginStart="8dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center"
                                        android:minWidth="52dp"
                                        android:paddingStart="6dp"
                                        android:paddingEnd="6dp"
                                        android:singleLine="true"
                                        android:text="@string/activity_model_settings_text_07"
                                        android:textColor="@color/primary"
                                        android:textSize="14sp"
                                        android:visibility="gone" />

                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <Button
                                android:id="@+id/btnWhisperConfig"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:text="@string/activity_model_settings_text_08" />

                            <Button
                                android:id="@+id/btnSwitchAsrModel"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:text="@string/activity_model_settings_text_09" />

                            <LinearLayout
                                android:id="@+id/layoutSenseVoiceProviderOptions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/tvSenseVoiceCpuOption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:minWidth="44dp"
                                    android:text="CPU"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSenseVoiceNpuOption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:minWidth="44dp"
                                    android:text="NPU"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutParakeetVariantOptions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/tvParakeetTdtOption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:minWidth="44dp"
                                    android:text="TDT"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvParakeetCtcOption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:minWidth="44dp"
                                    android:text="CTC"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Decoder -->
                    <LinearLayout
                        android:id="@+id/layoutDecoder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/activity_model_settings_text_10"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tvDecoderFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/activity_auto_timestamp_text_04"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btnSelectDecoder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/activity_model_settings_text_11"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                    <!-- Joiner -->
                    <LinearLayout
                        android:id="@+id/layoutJoiner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Joiner 模型"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvJoinerFile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:text="@string/activity_auto_timestamp_text_04"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnSelectJoiner"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="选择 Joiner" />

                    </LinearLayout>

                    <!-- Tokens -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/activity_model_settings_text_12"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tvTokensFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/activity_auto_timestamp_text_04"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btnSelectTokens"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/activity_model_settings_text_13"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <TextView
                        android:id="@+id/tvModelGuide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="end"
                        android:text="@string/tts_help"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- VAD 模型 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_model_settings_text_14"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tvVadFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/activity_model_settings_text_15"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSelectVad"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_model_settings_text_16" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbUseBuiltInVad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/activity_model_settings_text_17"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
