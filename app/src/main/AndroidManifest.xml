<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    
    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:name=".SubtitleEditApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubtitleEditforAndroid"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="34">

        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SubtitleEditforAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OpenSubtitleActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <!-- MIME matching also handles content:// URIs whose paths are opaque IDs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/srt" />
                <data android:mimeType="application/x-srt" />
                <data android:mimeType="text/srt" />
                <data android:mimeType="text/x-srt" />
                <data android:mimeType="text/vtt" />
                <data android:mimeType="application/vtt" />
                <data android:mimeType="text/lrc" />
                <data android:mimeType="text/x-lrc" />
                <data android:mimeType="application/lrc" />
                <data android:mimeType="application/x-lrc" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Some file managers use generic/incorrect MIME types. Limit that fallback
                 to subtitle/text extensions instead of advertising support for every file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".lrc" tools:targetApi="s" />
                <data android:pathSuffix=".srt" tools:targetApi="s" />
                <data android:pathSuffix=".vtt" tools:targetApi="s" />
                <data android:pathSuffix=".txt" tools:targetApi="s" />
                <data android:pathSuffix=".LRC" tools:targetApi="s" />
                <data android:pathSuffix=".SRT" tools:targetApi="s" />
                <data android:pathSuffix=".VTT" tools:targetApi="s" />
                <data android:pathSuffix=".TXT" tools:targetApi="s" />
                <!-- Legacy path matching for Android 8–11, including multi-dot names. -->
                <data android:pathPattern=".*\\.lrc" />
                <data android:pathPattern=".*\\.srt" />
                <data android:pathPattern=".*\\.vtt" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.LRC" />
                <data android:pathPattern=".*\\.SRT" />
                <data android:pathPattern=".*\\.VTT" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\..*\\.lrc" />
                <data android:pathPattern=".*\\..*\\.srt" />
                <data android:pathPattern=".*\\..*\\.vtt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\.LRC" />
                <data android:pathPattern=".*\\..*\\.SRT" />
                <data android:pathPattern=".*\\..*\\.VTT" />
                <data android:pathPattern=".*\\..*\\.TXT" />
            </intent-filter>
            <!-- A URI with no MIME type needs a separate filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".lrc" tools:targetApi="s" />
                <data android:pathSuffix=".srt" tools:targetApi="s" />
                <data android:pathSuffix=".vtt" tools:targetApi="s" />
                <data android:pathSuffix=".txt" tools:targetApi="s" />
                <data android:pathSuffix=".LRC" tools:targetApi="s" />
                <data android:pathSuffix=".SRT" tools:targetApi="s" />
                <data android:pathSuffix=".VTT" tools:targetApi="s" />
                <data android:pathSuffix=".TXT" tools:targetApi="s" />
                <data android:pathPattern=".*\\.lrc" />
                <data android:pathPattern=".*\\.srt" />
                <data android:pathPattern=".*\\.vtt" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.LRC" />
                <data android:pathPattern=".*\\.SRT" />
                <data android:pathPattern=".*\\.VTT" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\..*\\.lrc" />
                <data android:pathPattern=".*\\..*\\.srt" />
                <data android:pathPattern=".*\\..*\\.vtt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\.LRC" />
                <data android:pathPattern=".*\\..*\\.SRT" />
                <data android:pathPattern=".*\\..*\\.VTT" />
                <data android:pathPattern=".*\\..*\\.TXT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ArchivePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".BatchConvertActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".DraftsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".MediaConvertActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".SpeechToSubtitleActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".VocalSeparationActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".VocalSeparationSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".AutoTranslateActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".FileManagementSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".AutoTimestampActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".SubtitleFormatSelectActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".SubtitleFormatEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

          <activity
             android:name=".SpeechToSubtitleSettingsActivity"
             android:exported="false"
             android:theme="@style/Theme.SubtitleEditforAndroid" />
          <activity
             android:name=".VadModelSettingsActivity"
             android:exported="false"
             android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".WhisperSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".TtsSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".ModelManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

    </application>

</manifest>
