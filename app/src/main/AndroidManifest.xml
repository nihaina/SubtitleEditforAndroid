<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    
    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:name=".SubtitleEditApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubtitleEditforAndroid"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="34">

        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SubtitleEditforAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ArchivePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".BatchConvertActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".DraftsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />
            
        <activity
            android:name=".MediaConvertActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".SpeechToSubtitleActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".VocalSeparationActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".VocalSeparationSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".FileManagementSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".AutoTimestampActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ModelSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".SubtitleFormatSelectActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".SubtitleFormatEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".SpeechToSubtitleSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".WhisperSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".TtsSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".ModelManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:theme="@style/Theme.SubtitleEditforAndroid" />

    </application>

</manifest>
