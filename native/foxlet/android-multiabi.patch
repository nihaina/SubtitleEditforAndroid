+static uint64_t shortlistChecksum(const void* data, size_t size) {
+  const auto* bytes = static_cast<const char*>(data);
+  uint64_t checksum = 0;
+  for (size_t offset = 2 * sizeof(uint64_t); offset + sizeof(uint64_t) <= size; offset += sizeof(uint64_t)) {
+    uint64_t word;
+    std::memcpy(&word, bytes + offset, sizeof(word));
+    checksum ^= word + UINT64_C(0x9e3779b9) + (checksum << 6) + (checksum >> 2);
+  }
+  return checksum;
+}
